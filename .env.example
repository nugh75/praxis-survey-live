# Backend
DATABASE_URL=postgresql+asyncpg://praxis:praxis@db:5432/praxis_survey
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Postgres (docker-compose)
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis
POSTGRES_DB=praxis_survey

# Auth admin (ai4auth)
ADMIN_GROUP=admins
# Segreto condiviso col vhost nginx (header X-Forwarded-Auth-Secret). Generare
# lungo e casuale; tenere identico in nginx-praxis.ai4educ.org.conf.
FORWARD_AUTH_SHARED_SECRET=
AI4AUTH_VERIFY_URL=https://auth.ai4educ.org/api/verify
# Dev senza proxy: 1 = tratta tutti come admin (MAI in produzione)
ADMIN_AUTH_DISABLED=0

# Frontend (Vite) - usato a build time
# PRODUZIONE: lasciare vuoto (path relativi, same-origin dietro proxy).
VITE_API_URL=http://localhost:8000
# Hostname pubblico per il redirect di login (?rd=). Opzionale.
VITE_APP_URL=https://praxis.ai4educ.org
